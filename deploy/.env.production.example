# ==========================================================================
# MoaSpace — Environment PRODUKSI (VPS)
# ==========================================================================
# Salin file ini jadi `.env` di direktori yang sama (SEJAJAR dengan
# docker-compose.yml), lalu isi semua nilainya. File `.env` TIDAK BOLEH
# masuk git (sudah di-.gitignore lewat pola ".env" global).
#
#   cp .env.production.example .env
#   nano .env
#
# Satu file ini dipakai bersama oleh service `backend` DAN `frontend`
# (lihat `env_file: .env` di docker-compose.yml) — jadi JWT_SECRET dan
# ALLOWED_ORIGINS di sini otomatis konsisten untuk keduanya.

# ────────────────────────────────────────────────────────────────────────
# Shared infra
# ────────────────────────────────────────────────────────────────────────

# Password database Postgres. Generate yang kuat, contoh: openssl rand -hex 24
POSTGRES_PASSWORD=

# Email untuk notifikasi Let's Encrypt (penerbitan/perpanjangan sertifikat)
CERTBOT_EMAIL=

# Akun Super Admin SATU-SATUNYA yang dibuat otomatis saat deploy (lihat
# packages/database/scripts/seed-production.ts). 7 divisi default organisasi
# ikut dibuat (tanpa anggota), TAPI tidak ada akun Kormanit atau data contoh
# (task/story/epic/request) apa pun — admin ini yang mengatur anggota &
# penugasan lewat UI setelah login. Idempotent: deploy berikutnya TIDAK
# menimpa password yang sudah ada, jadi aman kalau nanti Anda ganti password
# lewat aplikasi lalu deploy ulang.
ADMIN_EMAIL=admin@moaspace.my.id
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin

# ────────────────────────────────────────────────────────────────────────
# Backend (NestJS) — apps/api
# ────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Wajib SAMA PERSIS dengan JWT_SECRET frontend di bawah. Minimal 32 karakter
# acak. Generate: openssl rand -hex 32
JWT_SECRET=

# Domain publik frontend (dipakai backend untuk validasi CORS)
ALLOWED_ORIGINS=https://app.moaspace.my.id

# Domain publik frontend (dipakai backend untuk membuat link yang dikirim ke
# pengguna, misal link reset password & aktivasi akun). WAJIB domain asli
# Anda — kalau dibiarkan kosong/salah, link di email/log akan tetap mengarah
# ke localhost meski sudah di production.
FRONTEND_URL=https://app.moaspace.my.id

# Cloudflare R2 Object Storage (upload gambar editor, dsb.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=moaspace
R2_PUBLIC_URL=

# Google OAuth 2.0 (opsional — hanya perlu diisi kalau tombol "Login with
# Google" dipakai). Dari Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WAJIB domain asli + path persis ini (BFF frontend yang menangani callback,
# bukan backend langsung). Nilai ini dipakai backend DAN frontend (lewat
# env_file: .env yang sama) untuk tahap "mulai login" dan "tukar kode" —
# kalau salah satu beda sedikit saja (domain, skema http/https, trailing
# slash), Google menolak tukar kode dengan error "Kode otorisasi tidak
# valid". Daftarkan PERSIS nilai ini juga di Google Cloud Console sebagai
# salah satu "Authorized redirect URIs".
GOOGLE_CALLBACK_URL=https://app.moaspace.my.id/api/auth/google/callback

# ────────────────────────────────────────────────────────────────────────
# Frontend (Next.js) — server-side (dibaca saat request, boleh diubah tanpa rebuild)
# ────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Catatan: NEXT_PUBLIC_APP_URL dan NEXT_PUBLIC_API_URL TIDAK dibaca dari sini
# saat runtime — keduanya di-inline ke bundle JS saat `docker build` (lihat
# step build-arg di .github/workflows/cd.yml milik frontend). Kalau domain
# berubah, image frontend WAJIB di-build ulang, bukan cuma restart container.
