# ==========================================
# MoaSpace Backend API Configuration
# ==========================================

# Application Port
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moaspace"

# Redis Cache URL
REDIS_URL="redis://localhost:6379"

# JWT Secret Key (min 32 characters, must match frontend)
JWT_SECRET=your-secret-key-change-me-in-production-min-32-chars

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
